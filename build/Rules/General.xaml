<Rule Name="ConfigurationGeneral" DisplayName="General" PageTemplate="generic" xmlns="http://schemas.microsoft.com/build/2009/properties">
  <Rule.DataSource><DataSource Persistence="ProjectFile" HasConfigurationCondition="false" /></Rule.DataSource>
  <EnumProperty Name="OutputType" DisplayName="Output type">
    <EnumValue Name="Exe" DisplayName="Executable" /><EnumValue Name="Library" DisplayName="Source library" />
  </EnumProperty>
  <BoolProperty Name="NoStdLib" DisplayName="Exclude standard library" Description="Compile only the explicitly selected sources and project references. No bundled std declarations are added." />
  <StringProperty Name="OutputPath" DisplayName="Output directory" />
  <StringProperty Name="GflatCompilerCommand" DisplayName="Compiler command" />
  <EnumProperty Name="GflatOptimizationLevel" DisplayName="Optimization level" Description="Debug defaults to 0; Release defaults to 2.">
    <EnumValue Name="0" DisplayName="0 — No optimization" />
    <EnumValue Name="1" DisplayName="1 — Basic optimization" />
    <EnumValue Name="2" DisplayName="2 — Recommended optimization" />
    <EnumValue Name="3" DisplayName="3 — Aggressive optimization" />
  </EnumProperty>
  <IntProperty Name="GflatExceptionReserveBytes" DisplayName="Exception reserve (bytes)" MinValue="0" Description="Emergency storage for the native exception runtime. Default: 65536 bytes. Zero disables the reserve. Used when linking an executable." />
</Rule>
