<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Runtime" Version="17.14.28" GeneratePathProperty="true" />
    <!-- Use the serviced cryptography dependency, rather than MSBuild's original minimum. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../LICENSES/MSBuild.txt" Link="Licenses/MSBuild/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Build_Runtime)/notices/THIRDPARTYNOTICES.txt" Link="Licenses/MSBuild/THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Build both task variants; don't load either into the application itself. -->
    <ProjectReference Include="../gflat.Build.Tasks/gflat.Build.Tasks.csproj" ReferenceOutputAssembly="false" Private="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained;PublishDir" />
  </ItemGroup>
</Project>
