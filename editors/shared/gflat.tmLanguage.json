{
  "name": "gflat",
  "scopeName": "source.gflat",
  "fileTypes": [
    "gf",
    "gfh"
  ],
  "patterns": [
    {
      "name": "meta.preprocessor.gflat",
      "begin": "^\\s*(#)\\s*(define)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.directive.gflat" },
        "2": { "name": "keyword.control.directive.gflat" },
        "3": { "name": "entity.name.function.preprocessor.gflat" }
      },
      "end": "(?<!\\\\)$",
      "patterns": [
        { "match": "##|#", "name": "keyword.operator.gflat" },
        { "include": "$self" }
      ]
    },
    {
      "name": "meta.preprocessor.gflat",
      "begin": "^\\s*(#)\\s*(include)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.directive.gflat" },
        "2": { "name": "keyword.control.directive.gflat" }
      },
      "end": "(?<!\\\\)$",
      "patterns": [
        { "name": "string.quoted.double.gflat", "begin": "<", "end": ">|$" },
        { "include": "$self" }
      ]
    },
    {
      "name": "meta.preprocessor.gflat",
      "begin": "^\\s*(#)\\s*(undef|if|ifdef|ifndef|elif|elifdef|elifndef|else|endif|pragma|error|warning)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.directive.gflat" },
        "2": { "name": "keyword.control.directive.gflat" }
      },
      "end": "(?<!\\\\)$",
      "patterns": [ { "include": "$self" } ]
    },
    {
      "name": "variable.other.gflat",
      "match": "@[A-Za-z_][A-Za-z0-9_]*"
    },
    {
      "name": "storage.modifier.gflat",
      "match": "\\bimplementation\\b(?=\\s+[A-Za-z_][A-Za-z0-9_:]*\\s*[:{])|\\bextension\\b(?=\\s+implementation\\b)|\\bextension\\b(?=\\s*(?:<[^;{}]*>\\s*)?[A-Za-z_][A-Za-z0-9_:]*(?:\\s*<[^;{}]*>)?\\s*(?:\\{|$))|\\bexplicit\\b(?=\\s+operator\\b)|\\bconstrained\\b(?=\\s+(?:(?:public|private|protected|internal|weak|expect|replace|constrained)\\s+)*alias\\b)"
    },
    {
      "name": "keyword.other.accessor.gflat",
      "match": "\\b(get|set)\\b(?=\\s*(?:\\{|=>|;|nothrow\\b|$))"
    },
    {
      "name": "comment.line.documentation.gflat",
      "begin": "(///)(?!/)",
      "beginCaptures": { "1": { "name": "punctuation.definition.documentation.gflat" } },
      "end": "$",
      "patterns": [
        { "name": "entity.name.tag.documentation.gflat", "match": "(?<!\\S)[@\\\\](?:brief|details|param|tparam|return|returns|throws|throw|exception|ref|c|code|endcode)\\b" }
      ]
    },
    {
      "name": "comment.line.double-slash.gflat",
      "begin": "//",
      "end": "$"
    },
    {
      "name": "comment.block.gflat",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "include": "#interpolated-string"
    },
    {
      "name": "string.quoted.double.gflat",
      "begin": "(?:(\\b[A-Za-z_][A-Za-z0-9_]*|\\$))?(\")",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.literal.gflat"
        },
        "2": {
          "name": "punctuation.definition.string.begin.gflat"
        }
      },
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.gflat",
          "match": "\\\\[nrt0\\\\\"\\x27]"
        },
        {
          "name": "invalid.illegal.escape.gflat",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.gflat",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        {
          "name": "constant.character.escape.gflat",
          "match": "\\\\[nrt0\\\\\"\\x27]"
        },
        {
          "name": "invalid.illegal.escape.gflat",
          "match": "\\\\."
        }
      ]
    },
    {
      "match": "\\b(class|struct|interface|enum)\\s+((?!(?:return|throw|if|else|while|for|break|continue|case|default)\\b)[A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.gflat"
        },
        "2": {
          "name": "entity.name.type.gflat"
        }
      }
    },
    {
      "match": "\\b((?:(?:public|private|protected|internal|unsafe|const|static|inline|readonly|immutable|virtual|override|expect|weak|replace|abstract|extern|nothrow|ref|move|copy)\\s+)+)((?!(?:get|set)\\b)(?:(?:readonly|immutable)\\s*\\(\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[A-Za-z0-9_ \\t:<>(),*^?\\[\\]]+>)?(?:\\s*\\))*(?:\\s*[*^?]|\\s*\\[[0-9_]*\\])*)(?=\\s*$)",
      "captures": {
        "1": {
          "patterns": [
            {
              "name": "storage.modifier.gflat",
              "match": "\\b(?:public|private|protected|internal|unsafe|const|static|inline|readonly|immutable|virtual|override|expect|weak|replace|abstract|extern|nothrow|ref|move|copy)\\b"
            }
          ]
        },
        "2": {
          "patterns": [
            {
              "include": "#type-reference"
            }
          ]
        }
      }
    },
    {
      "name": "constant.language.gflat",
      "match": "\\b(true|false|null|this|base)\\b"
    },
    {
      "name": "storage.type.gflat",
      "match": "\\b(void|int|float|double|bool|char|long|extralong|uint|ulong|nint|nuint|byte|sbyte|short|ushort|reflection|class|struct|interface|enum)\\b"
    },
    {
      "name": "storage.modifier.gflat",
      "match": "\\bfinalizer(?=\\s*~)"
    },
    {
      "name": "storage.modifier.gflat",
      "match": "\\b(public|private|protected|internal|unsafe|const|static|inline|readonly|immutable|virtual|override|expect|weak|replace|abstract|extern|nothrow|ref|move|copy)\\b"
    },
    {
      "name": "keyword.control.gflat",
      "match": "\\b(return|if|else|while|for|foreach|in|repeat|break|continue|switch|case|defer|throw|try|catch)\\b"
    },
    {
      "name": "keyword.other.gflat",
      "match": "(?<=\\.)[ \\t]*\\breinterpret\\b(?=\\s*<)"
    },
    {
      "name": "keyword.other.gflat",
      "match": "\\b(namespace|using|new|delete|default|alias|global|operator|sizeof|alignof|typeof|reflect|nameof|managed)\\b"
    },
    {
      "name": "constant.numeric.gflat",
      "match": "\\b(?:0x[0-9a-fA-F]+(?:[uU][lL]?|[lL][uU]?)?|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[uU][lL]?|[lL][uU]?|[fFdDmM])?)\\b"
    },
    {
      "name": "entity.name.type.gflat",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=[A-Za-z0-9_ \\t:<>,()*^?\\[\\]]*\\boperator\\b)"
    },
    {
      "match": "(?<![A-Za-z0-9_:.])(?![A-Za-z_][A-Za-z0-9_]*\\s*\\))\\b((?:(?:readonly|immutable)\\s*\\(\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[A-Za-z0-9_ \\t:<>(),*^?\\[\\]]+>)?(?:\\s*\\))*(?:\\s*[*^?]|\\s*\\[[0-9_]*\\])*)\\s+((?!(?:return|throw|if|else|while|for|break|continue|case|default)\\b)[A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:<[A-Za-z0-9_ \\t:,<>*^?\\[\\]]+>)?\\s*\\()",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type-reference"
            }
          ]
        },
        "2": {
          "name": "entity.name.function.gflat"
        }
      }
    },
    {
      "match": "(?<![A-Za-z0-9_:.])(?![A-Za-z_][A-Za-z0-9_]*\\s*\\))\\b((?:(?:readonly|immutable)\\s*\\(\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[A-Za-z0-9_ \\t:<>(),*^?\\[\\]]+>)?(?:\\s*\\))*(?:\\s*[*^?]|\\s*\\[[0-9_]*\\])*)\\s+((?!(?:return|throw|if|else|while|for|break|continue|case|default)\\b)[A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:[;=,){\\[]|=>|$))",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type-reference"
            }
          ]
        },
        "2": {
          "patterns": [
            {
              "name": "constant.language.gflat",
              "match": "\\bthis\\b"
            }
          ]
        }
      }
    },
    {
      "match": "(?<=\\bnew)\\s*[*^]?\\s+((?:(?:readonly|immutable)\\s*\\(\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:\\s*<[A-Za-z0-9_ \\t:<>(),*^?\\[\\]]+?>)?(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s*<[A-Za-z0-9_ \\t:<>(),*^?\\[\\]]+?>)?)*(?:\\s*\\))*(?:\\s*[*^?]|\\s*\\[[0-9_]*\\])*)(?=\\s*\\()",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type-reference"
            }
          ]
        }
      }
    },
    {
      "match": "(?:(?<=\\breadonly)|(?<=\\bimmutable))\\s*\\(((?:(?:readonly|immutable)\\s*\\(\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[A-Za-z0-9_ \\t:<>(),*^?\\[\\]]+>)?(?:\\s*\\))*(?:\\s*[*^?]|\\s*\\[[0-9_]*\\])*)\\)",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type-reference"
            }
          ]
        }
      }
    },
    {
      "match": "(?:(?<=\\bsizeof)|(?<=\\balignof)|(?<=\\breflect))\\s*\\(((?:sizeof\\s*\\(\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[A-Za-z0-9_ \\t:<>(),*^?\\[\\]]+>)?(?:\\s*\\))*(?:\\s*[*^?]|\\s*\\[[0-9_]*\\])*)\\)",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type-reference"
            }
          ]
        }
      }
    },
    {
      "match": "(?<!:):(?!:)\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*)*)(?=\\s*(?:\\{|$))",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type-reference"
            }
          ]
        }
      }
    },
    {
      "name": "entity.name.function.gflat",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.gflat",
      "match": "::|=>|[+*/%=!<>~&|^?:-]"
    },
    {
      "name": "punctuation.section.gflat",
      "match": "[{}\\[\\]()]"
    },
    {
      "name": "punctuation.separator.gflat",
      "match": "[;,.]"
    }
  ],
  "repository": {
    "interpolated-string": {
      "name": "meta.interpolated-string.gflat",
      "begin": "(?:\\b([A-Za-z_][A-Za-z0-9_]*))?(\\$)(\")",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.literal.gflat"
        },
        "2": {
          "name": "keyword.operator.interpolation.gflat"
        },
        "3": {
          "name": "punctuation.definition.string.begin.gflat"
        }
      },
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.gflat",
          "match": "\\\\[nrt0\\\\\"\\x27]"
        },
        {
          "name": "invalid.illegal.escape.gflat",
          "match": "\\\\."
        },
        {
          "name": "constant.character.escape.gflat",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.interpolation.gflat",
          "contentName": "source.gflat",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.gflat"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.gflat"
            }
          },
          "patterns": [
            {
              "include": "#interpolation-braces"
            },
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "string.quoted.double.gflat",
          "match": "[^\\\\{}\"]+"
        }
      ],
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.gflat"
        }
      }
    },
    "interpolation-braces": {
      "begin": "\\{",
      "end": "\\}",
      "name": "punctuation.section.gflat",
      "patterns": [
        {
          "include": "#interpolation-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "type-reference": {
      "patterns": [
        {
          "name": "storage.modifier.gflat",
          "match": "\\b(public|private|protected|internal|unsafe|const|static|inline|readonly|immutable|virtual|override|expect|weak|replace|abstract|extern|nothrow|ref|move|copy)\\b"
        },
        {
          "name": "storage.type.gflat",
          "match": "\\b(void|int|float|double|bool|char|long|extralong|uint|ulong|nint|nuint|byte|sbyte|short|ushort|class|struct|interface|enum)\\b"
        },
        {
          "name": "entity.name.qualifier.gflat",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*::)"
        },
        {
          "name": "entity.name.type.gflat",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "keyword.operator.gflat",
          "match": "::|[<>*^?]"
        },
        {
          "name": "punctuation.section.gflat",
          "match": "[()\\[\\]]"
        }
      ]
    }
  }
}
