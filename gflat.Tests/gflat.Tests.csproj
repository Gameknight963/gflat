<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../editors/VisualStudio/GflatExceptionReport.cs" Link="Editor/GflatExceptionReport.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\gflat\gflat.csproj" />
    <None Include="..\std\**\*.gf" Link="Std\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\LANGUAGE_SPEC.md" Link="LANGUAGE_SPEC.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\*.md" Exclude="..\docs\LANGUAGE_SPEC.md" Link="Guides\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\std\**\*.md" Link="Guides\std\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\seq\main.gf" Link="Examples\seq.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\tail\main.gf" Link="Examples\tail.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\search\main.gf" Link="Examples\search.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\tasks\main.gf" Link="Examples\tasks.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\hexdump\main.gf" Link="Examples\hexdump.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\transcode\main.gf" Link="Examples\transcode.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\quote-lines\main.gf" Link="Examples\quote-lines.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\unquote-lines\main.gf" Link="Examples\unquote-lines.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\json-check\main.gf" Link="Examples\json-check.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\ip-count\main.gf" Link="Examples\ip-count.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\json-minify\main.gf" Link="Examples\json-minify.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\number-stats\main.gf" Link="Examples\number-stats.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\sort-lines\main.gf" Link="Examples\sort-lines.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\settings-json\main.gf" Link="Examples\settings-json.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\csv-sum\main.gf" Link="Examples\csv-sum.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\csv-to-json\main.gf" Link="Examples\csv-to-json.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\checksum\main.gf" Link="Examples\checksum.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\word-count\main.gf" Link="Examples\word-count.gf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\examples\providers\*.gf" Link="Examples\providers\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
