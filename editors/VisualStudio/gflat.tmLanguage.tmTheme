<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
  <dict>
    <key>name</key><string>gflat</string>
    <key>settings</key>
    <array>
      <dict>
        <key>scope</key><string>comment.line.documentation.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>xml doc comment - text</string></dict>
      </dict>
      <dict>
        <key>scope</key><string>punctuation.definition.documentation.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>xml doc comment - delimiter</string></dict>
      </dict>
      <dict>
        <key>scope</key><string>entity.name.tag.documentation.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>xml doc comment - name</string></dict>
      </dict>
      <dict>
        <key>scope</key><string>entity.name.function.preprocessor.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>cppMacro</string></dict>
      </dict>
      <dict>
        <key>scope</key><string>punctuation.definition.directive.gflat, keyword.control.directive.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>preprocessor keyword</string></dict>
      </dict>
      <dict>
        <key>scope</key><string>comment.line.double-slash.gflat, comment.block.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>comment</string></dict>
      </dict>
      <dict>
        <key>scope</key><string>entity.name.qualifier.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>identifier</string></dict>
      </dict>
      <dict>
        <key>scope</key><string>entity.name.function.gflat, entity.name.function.literal.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>method name</string></dict>
      </dict>
      <dict>
        <key>scope</key><string>entity.name.type.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>type</string></dict>
      </dict>
      <dict>
        <key>scope</key><string>storage.type.gflat, storage.modifier.gflat, keyword.other.gflat, keyword.other.accessor.gflat, constant.language.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>keyword</string></dict>
      </dict>
      <dict>
        <key>scope</key><string>keyword.control.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>keyword - control</string></dict>
      </dict>
      <dict>
        <key>scope</key><string>string.quoted.double.gflat, string.quoted.single.gflat, punctuation.definition.string.begin.gflat, punctuation.definition.string.end.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>string</string></dict>
      </dict>
      <dict>
        <key>scope</key><string>constant.numeric.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>number</string></dict>
      </dict>
      <dict>
        <key>scope</key><string>constant.character.escape.gflat, invalid.illegal.escape.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>string - escape character</string></dict>
      </dict>
      <dict>
        <key>scope</key><string>keyword.operator.gflat, keyword.operator.interpolation.gflat, punctuation.section.interpolation.begin.gflat, punctuation.section.interpolation.end.gflat</string>
        <key>settings</key><dict><key>vsclassificationtype</key><string>operator</string></dict>
      </dict>
    </array>
  </dict>
</plist>
