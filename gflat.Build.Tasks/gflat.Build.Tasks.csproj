<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Artifacts output skips the SDK's usual framework suffix. Keep these
         runtime-specific SDK assets distinct under either output convention. -->
    <OutputPath>../build/tasks/</OutputPath>
    <OutputPath Condition="'$(UseArtifactsOutput)' == 'true'">../build/tasks/$(TargetFramework)/</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- The engine supplies these at runtime, including when hosted by Visual Studio. -->
    <PackageReference Include="Microsoft.Build" Version="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net472'" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../gflat.Projects/NativeLinkInputs.cs" Link="NativeLinkInputs.cs" />
    <Reference Include="System.Xml.Linq" Condition="'$(TargetFramework)' == 'net472'" />
  </ItemGroup>
</Project>
