{
  "name": "gflat",
  "scopeName": "source.gflat",
  "fileTypes": [
    "gf"
  ],
  "patterns": [
    {
      "name": "comment.line.double-slash.gflat",
      "begin": "//",
      "end": "$"
    },
    {
      "name": "comment.block.gflat",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "include": "#interpolated-string"
    },
    {
      "name": "string.quoted.double.gflat",
      "begin": "(?:(\\b[A-Za-z_][A-Za-z0-9_]*|\\$))?(\")",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.literal.gflat"
        },
        "2": {
          "name": "punctuation.definition.string.begin.gflat"
        }
      },
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.gflat",
          "match": "\\\\[nrt0\\\\\"\\x27]"
        },
        {
          "name": "invalid.illegal.escape.gflat",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.gflat",
      "begin": "'",
      "end": "'|$",
      "patterns": [
        {
          "name": "constant.character.escape.gflat",
          "match": "\\\\[nrt0\\\\\"\\x27]"
        },
        {
          "name": "invalid.illegal.escape.gflat",
          "match": "\\\\."
        }
      ]
    },
    {
      "match": "\\b(class|struct|interface|enum)\\s+((?!(?:return|throw|if|else|while|for|break|continue|case|default)\\b)[A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.gflat"
        },
        "2": {
          "name": "entity.name.type.gflat"
        }
      }
    },
    {
      "match": "\\b((?:(?:public|private|protected|internal|unsafe|const|static|readonly|virtual|override|weak|replace|abstract|extern|throws)\\s+)+)((?:readonly\\s*\\(\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[A-Za-z0-9_ \\t:<>(),*^?\\[\\]]+>)?(?:\\s*\\))*(?:\\s*[*^?]|\\s*\\[[0-9_]*\\])*)(?=\\s*$)",
      "captures": {
        "1": {
          "patterns": [
            {
              "name": "storage.modifier.gflat",
              "match": "\\b(?:public|private|protected|internal|unsafe|const|static|readonly|virtual|override|weak|replace|abstract|extern|throws)\\b"
            }
          ]
        },
        "2": {
          "patterns": [
            {
              "include": "#type-reference"
            }
          ]
        }
      }
    },
    {
      "name": "constant.language.gflat",
      "match": "\\b(true|false|null|this|base)\\b"
    },
    {
      "name": "storage.type.gflat",
      "match": "\\b(void|int|float|double|bool|char|long|extralong|uint|ulong|nint|nuint|byte|sbyte|short|ushort|class|struct|interface|enum)\\b"
    },
    {
      "name": "storage.modifier.gflat",
      "match": "\\b(public|private|protected|internal|unsafe|const|static|readonly|virtual|override|weak|replace|abstract|extern|throws)\\b"
    },
    {
      "name": "keyword.control.gflat",
      "match": "\\b(namespace|using|new|delete|return|if|else|while|for|foreach|in|repeat|break|continue|switch|case|default|defer|alias|global|operator|sizeof|alignof|nameof|throw|try|catch)\\b"
    },
    {
      "name": "keyword.other.accessor.gflat",
      "match": "\\b(get|set)\\b(?=\\s*(?:\\{|=>|;|throws\\b))"
    },
    {
      "name": "constant.numeric.gflat",
      "match": "\\b(?:0x[0-9a-fA-F]+(?:[uU][lL]?|[lL][uU]?)?|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[uU][lL]?|[lL][uU]?|[fFdDmM])?)\\b"
    },
    {
      "name": "entity.name.type.gflat",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=[A-Za-z0-9_ \\t:<>,()*^?\\[\\]]*\\boperator\\b)"
    },
    {
      "match": "\\b((?:readonly\\s*\\(\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[A-Za-z0-9_ \\t:<>(),*^?\\[\\]]+>)?(?:\\s*\\))*(?:\\s*[*^?]|\\s*\\[[0-9_]*\\])*)\\s+((?!(?:return|throw|if|else|while|for|break|continue|case|default)\\b)[A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:<[A-Za-z0-9_ \\t:,<>*^?\\[\\]]+>)?\\s*\\()",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type-reference"
            }
          ]
        },
        "2": {
          "name": "entity.name.function.gflat"
        }
      }
    },
    {
      "match": "\\b((?:readonly\\s*\\(\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[A-Za-z0-9_ \\t:<>(),*^?\\[\\]]+>)?(?:\\s*\\))*(?:\\s*[*^?]|\\s*\\[[0-9_]*\\])*)\\s+((?!(?:return|throw|if|else|while|for|break|continue|case|default)\\b)[A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:[;=,){\\[]|=>|$))",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type-reference"
            }
          ]
        }
      }
    },
    {
      "match": "(?<=\\bnew)\\s*[*^]?\\s+((?:readonly\\s*\\(\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[A-Za-z0-9_ \\t:<>(),*^?\\[\\]]+>)?(?:\\s*\\))*(?:\\s*[*^?]|\\s*\\[[0-9_]*\\])*)(?=\\s*\\()",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type-reference"
            }
          ]
        }
      }
    },
    {
      "match": "(?<=\\breadonly)\\s*\\(((?:readonly\\s*\\(\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[A-Za-z0-9_ \\t:<>(),*^?\\[\\]]+>)?(?:\\s*\\))*(?:\\s*[*^?]|\\s*\\[[0-9_]*\\])*)\\)",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type-reference"
            }
          ]
        }
      }
    },
    {
      "match": "(?:(?<=\\bsizeof)|(?<=\\balignof))\\s*\\(((?:sizeof\\s*\\(\\s*)*[A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*<[A-Za-z0-9_ \\t:<>(),*^?\\[\\]]+>)?(?:\\s*\\))*(?:\\s*[*^?]|\\s*\\[[0-9_]*\\])*)\\)",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type-reference"
            }
          ]
        }
      }
    },
    {
      "match": "(?<!:):(?!:)\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s*::\\s*[A-Za-z_][A-Za-z0-9_]*)*)*)(?=\\s*(?:\\{|$))",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type-reference"
            }
          ]
        }
      }
    },
    {
      "name": "entity.name.function.gflat",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    {
      "name": "keyword.operator.gflat",
      "match": "::|=>|[+*/%=!<>~&|^?:-]"
    },
    {
      "name": "punctuation.section.gflat",
      "match": "[{}\\[\\]()]"
    },
    {
      "name": "punctuation.separator.gflat",
      "match": "[;,.]"
    }
  ],
  "repository": {
    "interpolated-string": {
      "name": "meta.interpolated-string.gflat",
      "begin": "(?:\\b([A-Za-z_][A-Za-z0-9_]*))?(\\$)(\")",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.literal.gflat"
        },
        "2": {
          "name": "keyword.operator.interpolation.gflat"
        },
        "3": {
          "name": "punctuation.definition.string.begin.gflat"
        }
      },
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.gflat",
          "match": "\\\\[nrt0\\\\\"\\x27]"
        },
        {
          "name": "invalid.illegal.escape.gflat",
          "match": "\\\\."
        },
        {
          "name": "constant.character.escape.gflat",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.interpolation.gflat",
          "contentName": "source.gflat",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.gflat"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.gflat"
            }
          },
          "patterns": [
            {
              "include": "#interpolation-braces"
            },
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "string.quoted.double.gflat",
          "match": "[^\\\\{}\"]+"
        }
      ],
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.gflat"
        }
      }
    },
    "interpolation-braces": {
      "begin": "\\{",
      "end": "\\}",
      "name": "punctuation.section.gflat",
      "patterns": [
        {
          "include": "#interpolation-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "type-reference": {
      "patterns": [
        {
          "name": "storage.modifier.gflat",
          "match": "\\b(public|private|protected|internal|unsafe|const|static|readonly|virtual|override|weak|replace|abstract|extern|throws)\\b"
        },
        {
          "name": "storage.type.gflat",
          "match": "\\b(void|int|float|double|bool|char|long|extralong|uint|ulong|nint|nuint|byte|sbyte|short|ushort|class|struct|interface|enum)\\b"
        },
        {
          "name": "entity.name.type.gflat",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "keyword.operator.gflat",
          "match": "::|[<>*^?]"
        },
        {
          "name": "punctuation.section.gflat",
          "match": "[()\\[\\]]"
        }
      ]
    }
  }
}
