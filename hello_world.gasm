CALL main
HALT

main:
    ENTER 0
    PUSH 'H'
    CALL_HOST io.print_char
    PUSH 'e'
    CALL_HOST io.print_char
    PUSH 'l'
    CALL_HOST io.print_char
    PUSH 'l'
    CALL_HOST io.print_char
    PUSH 'o'
    CALL_HOST io.print_char
    PUSH ','
    CALL_HOST io.print_char
    PUSH ' '
    CALL_HOST io.print_char
    PUSH 'W'
    CALL_HOST io.print_char
    PUSH 'o'
    CALL_HOST io.print_char
    PUSH 'r'
    CALL_HOST io.print_char
    PUSH 'l'
    CALL_HOST io.print_char
    PUSH 'd'
    CALL_HOST io.print_char
    PUSH '!'
    CALL_HOST io.print_char
    CALL_HOST io.print_newline
    RET