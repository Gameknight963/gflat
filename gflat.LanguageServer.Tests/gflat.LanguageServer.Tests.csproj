<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="TextMateSharp" Version="2.0.4" />
    <Content Include="../editors/shared/*.json" Link="EditorAssets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
    <Compile Include="../gflat.Tests/ProjectFileFixture.cs" Link="ProjectFileFixture.cs" />
    <ProjectReference Include="../gflat.LanguageServer/gflat.LanguageServer.csproj" />
  </ItemGroup>
</Project>
