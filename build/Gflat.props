<Project>
  <PropertyGroup>
    <GflatSdkRoot Condition="'$(GflatSdkRoot)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..'))</GflatSdkRoot>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <NoStdLib Condition="'$(NoStdLib)' == ''">false</NoStdLib>
    <OutputType Condition="'$(OutputType)' == ''">Exe</OutputType>
    <GflatExceptionReserveBytes Condition="'$(GflatExceptionReserveBytes)' == ''">65536</GflatExceptionReserveBytes>
    <GflatOptimizationLevel Condition="'$(GflatOptimizationLevel)' == '' and '$(Configuration)' == 'Release'">2</GflatOptimizationLevel>
    <GflatOptimizationLevel Condition="'$(GflatOptimizationLevel)' == ''">0</GflatOptimizationLevel>
    <EnableDefaultCompileItems Condition="'$(EnableDefaultCompileItems)' == ''">true</EnableDefaultCompileItems>
    <GflatDefaultExcludes>**/bin/**;**/obj/**;**/.git/**;**/.vs/**;**/.local-notes/**;**/*.gfproj.user</GflatDefaultExcludes>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="**/*.gf" Exclude="$(GflatDefaultExcludes)" Condition="'$(EnableDefaultCompileItems)' == 'true'" />
    <None Include="**/*" Exclude="**/*.gf;**/*.gfproj;$(GflatDefaultExcludes)" />
  </ItemGroup>
</Project>
