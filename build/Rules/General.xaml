<Rule Name="ConfigurationGeneral" DisplayName="General" PageTemplate="generic" xmlns="http://schemas.microsoft.com/build/2009/properties">
  <Rule.DataSource><DataSource Persistence="ProjectFile" HasConfigurationCondition="false" /></Rule.DataSource>
  <EnumProperty Name="OutputType" DisplayName="Output type">
    <EnumValue Name="Executable" DisplayName="Executable" /><EnumValue Name="SourceLibrary" DisplayName="Source library" />
    <EnumValue Name="StaticLibrary" DisplayName="Static library" /><EnumValue Name="DynamicLibrary" DisplayName="Dynamic library" />
  </EnumProperty>
  <BoolProperty Name="NoStdLib" DisplayName="Exclude standard library" Description="Compile only the explicitly selected sources and project references. No bundled std declarations are added." />
  <BoolProperty Name="NoBuiltins" DisplayName="Disable libc builtin recognition" Description="Prevent LLVM recognizing libc builtin patterns. Defaults to false, independently of NoStdLib. Explicit calls and intrinsics may still require runtime helpers." />
  <StringProperty Name="OutputPath" DisplayName="Output directory" />
  <EnumProperty Name="DeclarationScope" DisplayName="Declaration scope" Description="Project makes declarations available throughout the source project. File requires declarations in each caller. Individual Compile items and #scope directives can override this setting.">
    <EnumValue Name="Project" DisplayName="Project" /><EnumValue Name="File" DisplayName="File" />
  </EnumProperty>
  <StringProperty Name="RootNamespace" DisplayName="Default namespace" Description="Namespace prefix for new source files. Separate nested names with :: or a dot. This does not change existing source declarations." />
  <StringProperty Name="GflatNamespaceRoot" DisplayName="Namespace root directory" Description="Folders below this directory become namespaces in new files. Relative paths start at the project directory. Leave empty to use the project directory." />
  <StringProperty Name="GflatCompilerCommand" DisplayName="Compiler command" />
  <EnumProperty Name="RuntimeLibrary" DisplayName="Runtime library" Description="Windows C runtime used by native code. Leave unset to match referenced binary libraries. Builds without a detected setting use MultiThreaded.">
    <EnumValue Name="" DisplayName="Automatic" />
    <EnumValue Name="MultiThreaded" DisplayName="Multi-threaded (/MT)" />
    <EnumValue Name="MultiThreadedDLL" DisplayName="Multi-threaded DLL (/MD)" />
    <EnumValue Name="MultiThreadedDebug" DisplayName="Multi-threaded Debug (/MTd)" />
    <EnumValue Name="MultiThreadedDebugDLL" DisplayName="Multi-threaded Debug DLL (/MDd)" />
  </EnumProperty>
  <BoolProperty Name="DebugSymbols" DisplayName="Generate debug symbols" Description="Debug defaults to true. Emit source locations and native variable/type descriptions (PDB on Windows, DWARF on Linux)." />
  <EnumProperty Name="GflatOptimizationLevel" DisplayName="Optimization level" Description="Debug defaults to 0; Release defaults to 2.">
    <EnumValue Name="0" DisplayName="0 — No optimization" />
    <EnumValue Name="1" DisplayName="1 — Basic optimization" />
    <EnumValue Name="2" DisplayName="2 — Recommended optimization" />
    <EnumValue Name="3" DisplayName="3 — Aggressive optimization" />
  </EnumProperty>
  <IntProperty Name="GflatExceptionReserveBytes" DisplayName="Exception reserve (bytes)" MinValue="0" Description="Emergency storage for the native exception runtime. Default: 65536 bytes. Zero disables the reserve. Used when linking an executable." />
</Rule>
