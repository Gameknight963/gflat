<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- The VS client uses the framework toolchain, independent of the server's .NET SDK. -->
  <Import Project="$(MSBuildExtensionsPath)/$(MSBuildToolsVersion)/Microsoft.Common.props" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <ProjectGuid>{736CD94E-B446-4EC5-9D44-513907012953}</ProjectGuid>
    <OutputType>Library</OutputType>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <OutputPath>bin/$(Configuration)/net472/</OutputPath>
    <IntermediateOutputPath>obj/$(Configuration)/</IntermediateOutputPath>
    <DebugType>portable</DebugType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>gflat.VisualStudio</AssemblyName>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <!-- Bundled .NET runtime DLLs are content, never references for the .NET Framework VS client. -->
    <AssemblySearchPaths>{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.CoreUtility" Version="17.14.249" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Text.Logic" Version="17.14.249" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Telemetry" Version="17.14.2" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Utilities" Version="17.13.40008" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.ComponentModel.Composition" />
    <Compile Include="GflatLanguageClient.cs" />
    <Compile Include="AssemblyInfo.cs" />
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="../shared/gflat.tmLanguage.json">
      <Link>Grammars/gflat.tmLanguage.json</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../shared/gflat-language-configuration.json">
      <Link>gflat-language-configuration.json</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="gflat.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="obj/server/**/*">
      <Link>Server/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>
  <Target Name="RequireBundledServer" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('obj/server/gflat.LanguageServer.exe')" Text="Run build.ps1 to publish the bundled language server before building the VSIX." />
  </Target>
  <Import Project="$(MSBuildToolsPath)/Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)/VSSDK/Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)/VSSDK/Microsoft.VsSDK.targets')" />
</Project>
