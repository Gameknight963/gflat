<Project DefaultTargets="Build">
  <PropertyGroup>
    <_GflatTaskFramework Condition="'$(MSBuildRuntimeType)' == 'Full'">net472</_GflatTaskFramework>
    <_GflatTaskFramework Condition="'$(_GflatTaskFramework)' == ''">net10.0</_GflatTaskFramework>
    <GflatBuildTasksPath Condition="'$(GflatBuildTasksPath)' == ''">$(MSBuildThisFileDirectory)tasks/$(_GflatTaskFramework)/gflat.Build.Tasks.dll</GflatBuildTasksPath>
  </PropertyGroup>
  <UsingTask TaskName="gflat.Build.Tasks.GflatReadProjectInputs" AssemblyFile="$(GflatBuildTasksPath)" />
  <UsingTask TaskName="gflat.Build.Tasks.GflatWriteNativeLinkInputs" AssemblyFile="$(GflatBuildTasksPath)" />
  <UsingTask TaskName="gflat.Build.Tasks.GflatWritePreprocessorInputs" AssemblyFile="$(GflatBuildTasksPath)" />
  <UsingTask TaskName="gflat.Build.Tasks.GflatReadIncludeDependencies" AssemblyFile="$(GflatBuildTasksPath)" />
  <UsingTask TaskName="gflat.Build.Tasks.GflatWriteUpToDateState" AssemblyFile="$(GflatBuildTasksPath)" />
  <PropertyGroup>
    <GflatOptimizationLevel Condition="'$(GflatOptimizationLevel)' == '' and '$(Configuration)' == 'Release'">2</GflatOptimizationLevel>
    <GflatOptimizationLevel Condition="'$(GflatOptimizationLevel)' == ''">0</GflatOptimizationLevel>
    <DebugSymbols Condition="'$(DebugSymbols)' == '' and '$(Configuration)' == 'Debug'">true</DebugSymbols>
    <DebugSymbols Condition="'$(DebugSymbols)' == ''">false</DebugSymbols>
    <_GflatDebugOption Condition="'$(DebugSymbols)' == 'true'">--debug</_GflatDebugOption>
    <_GflatBuiltinsOption Condition="'$(NoBuiltins)' == 'true'">--no-builtins</_GflatBuiltinsOption>

    <DebuggerFlavor Condition="'$(DebuggerFlavor)' == ''">GflatLocal</DebuggerFlavor>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath);$(MSBuildProjectFullPath)</MSBuildAllProjects>
    <OutputPath Condition="'$(OutputPath)' == ''">bin/$(Configuration)/</OutputPath>
    <IntermediateOutputPath Condition="'$(IntermediateOutputPath)' == ''">obj/$(Configuration)/</IntermediateOutputPath>
    <TargetName Condition="'$(OutputType)' == 'Executable' and '$(TargetName)' == ''">$(MSBuildProjectName)</TargetName>
    <TargetExt Condition="'$(OutputType)' == 'Executable' and '$(TargetExt)' == ''">.exe</TargetExt>
    <TargetPath Condition="'$(OutputType)' == 'Executable' and '$(TargetPath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OutputPath)', '$(TargetName)$(TargetExt)'))</TargetPath>
    <GflatCompilerPath Condition="'$(GflatCompilerPath)' == '' and '$(GflatBundledCompiler)' != ''">$(GflatBundledCompiler)</GflatCompilerPath>
    <GflatCompilerPath Condition="'$(GflatCompilerPath)' == '' and Exists('$(GflatSdkRoot)/compiler/gflat.exe')">$(GflatSdkRoot)/compiler/gflat.exe</GflatCompilerPath>
    <GflatCompilerPath Condition="'$(GflatCompilerPath)' == '' and Exists('$(GflatSdkRoot)/compiler/gflat')">$(GflatSdkRoot)/compiler/gflat</GflatCompilerPath>
    <GflatCompilerPath Condition="'$(GflatCompilerPath)' == '' and Exists('$(GflatSdkRoot)/compiler/gflat.dll')">$(GflatSdkRoot)/compiler/gflat.dll</GflatCompilerPath>
    <GflatCompilerPath Condition="'$(GflatCompilerPath)' == '' and Exists('$(GflatSdkRoot)/../Compiler/gflat.exe')">$(GflatSdkRoot)/../Compiler/gflat.exe</GflatCompilerPath>
    <GflatCompilerPath Condition="'$(GflatCompilerPath)' == '' and Exists('$(GflatSdkRoot)/gflat/bin/Debug/net10.0/gflat.dll')">$(GflatSdkRoot)/gflat/bin/Debug/net10.0/gflat.dll</GflatCompilerPath>
    <_GflatKnownCompilerCommand Condition="'$(GflatCompilerPath)' != ''">&quot;$(GflatCompilerPath)&quot;</_GflatKnownCompilerCommand>
    <_GflatCompilerExtension>$([System.IO.Path]::GetExtension('$(GflatCompilerPath)'))</_GflatCompilerExtension>
    <_GflatKnownCompilerCommand Condition="'$(_GflatCompilerExtension)' == '.dll'">dotnet &quot;$(GflatCompilerPath)&quot;</_GflatKnownCompilerCommand>
    <GflatCompilerCommand Condition="'$(GflatCompilerCommand)' == '' and '$(_GflatKnownCompilerCommand)' != ''">$(_GflatKnownCompilerCommand)</GflatCompilerCommand>
    <GflatCompilerCommand Condition="'$(GflatCompilerCommand)' == ''">gflat</GflatCompilerCommand>
    <_GflatSourceList>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', '$(MSBuildProjectName).sources'))</_GflatSourceList>
    <_GflatBuildSettings>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', '$(MSBuildProjectName).build.settings'))</_GflatBuildSettings>
    <_GflatBuildSuccess>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', '$(MSBuildProjectName).build.success'))</_GflatBuildSuccess>
    <_GflatUpToDateState>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', '$(MSBuildProjectName).up-to-date.xml'))</_GflatUpToDateState>
    <_GflatNativeLinkManifest>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', '$(MSBuildProjectName).native-link.xml'))</_GflatNativeLinkManifest>
    <_GflatPreprocessorManifest>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', '$(MSBuildProjectName).preprocessor.xml'))</_GflatPreprocessorManifest>
    <_GflatIncludeDependencies>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', '$(MSBuildProjectName).includes'))</_GflatIncludeDependencies>
    <_GflatPreprocessorOption>--preprocessor-inputs &quot;$(_GflatPreprocessorManifest)&quot; --dependencies &quot;$(_GflatIncludeDependencies)&quot;</_GflatPreprocessorOption>
    <GflatIROutput Condition="'$(OutputType)' == 'Executable' and '$(GflatIROutput)' == ''">$([System.IO.Path]::ChangeExtension('$(TargetPath)', '.ll'))</GflatIROutput>
    <_GflatStdLibOption>--no-stdlib</_GflatStdLibOption>
    <_GflatClangOption Condition="'$(GflatClang)' != ''">--clang &quot;$(GflatClang)&quot;</_GflatClangOption>
  </PropertyGroup>
  <ItemGroup Condition="'$(NoStdLib)' != 'true'">
    <ProjectReference Include="$(GflatSdkRoot)/Standard/Standard.gfproj" />
  </ItemGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|AnyCPU"><Configuration>Debug</Configuration><Platform>AnyCPU</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|AnyCPU"><Configuration>Release</Configuration><Platform>AnyCPU</Platform></ProjectConfiguration>
  </ItemGroup>
  <ItemGroup>
    <ProjectCapability Include="Gflat;DeclaredSourceItems;UserSourceItems;UseFileGlobs;OpenProjectFile;HandlesOwnReload;ProjectConfigurationsDeclaredAsItems;ProjectReferences" />
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules/ProjectItemsSchema.xaml" />
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules/General.xaml"><Context>Project;BrowseObject</Context></PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules/GflatLocal.xaml;$(MSBuildThisFileDirectory)Rules/DebuggerGeneral.xaml"><Context>Project</Context></PropertyPageSchema>
    <PropertyPageSchema Include="$(MSBuildThisFileDirectory)Rules/Compile.xaml;$(MSBuildThisFileDirectory)Rules/None.xaml;$(MSBuildThisFileDirectory)Rules/Folder.xaml;$(MSBuildThisFileDirectory)Rules/ProjectReference.xaml"><Context>File;BrowseObject</Context></PropertyPageSchema>
  </ItemGroup>
  <Import Project="$(MSBuildProjectFullPath).user" Condition="Exists('$(MSBuildProjectFullPath).user')" />
  <Target Name="GflatGetSources" Returns="@(_GflatSources)">
    <Error Condition="'$(NoStdLib)' != 'true' and '$(NoStdLib)' != 'false'" Text="NoStdLib must be true or false." />
    <Error Condition="'$(NoBuiltins)' != 'true' and '$(NoBuiltins)' != 'false'" Text="NoBuiltins must be true or false." />
    <Error Condition="'$(OutputType)' != 'Executable' and '$(OutputType)' != 'SourceLibrary'" Text="OutputType must be Executable or SourceLibrary." />
    <Error Condition="'$(DebugSymbols)' != 'true' and '$(DebugSymbols)' != 'false'" Text="DebugSymbols must be true or false." />
    <Error Condition="'$(OutputType)' == 'SourceLibrary' and '$(GflatAsReference)' != 'true' and '$(GflatEmitIR)' == 'true'" Text="SourceLibrary projects have no standalone output; build an executable referencing them." />
    <Error Condition="'$(GflatOptimizationLevel)' != '0' and '$(GflatOptimizationLevel)' != '1' and '$(GflatOptimizationLevel)' != '2' and '$(GflatOptimizationLevel)' != '3'" Text="GflatOptimizationLevel must be 0, 1, 2, or 3." />
    <Error Condition="'$(GflatAsReference)' == 'true' and '$(OutputType)' != 'SourceLibrary'" Text="Only SourceLibrary projects can be referenced." />
    <MSBuild Projects="@(ProjectReference)" Targets="GflatGetSources" Properties="Configuration=$(Configuration);Platform=$(Platform);GflatAsReference=true">
      <Output TaskParameter="TargetOutputs" ItemName="_GflatReferenceSources" />
    </MSBuild>
    <ItemGroup><_GflatAllSources Include="@(Compile->'%(FullPath)');@(_GflatReferenceSources)" /></ItemGroup>
    <RemoveDuplicates Inputs="@(_GflatAllSources)"><Output TaskParameter="Filtered" ItemName="_GflatSources" /></RemoveDuplicates>
  </Target>
  <Target Name="_GflatValidateOutputs" DependsOnTargets="GflatGetSources">
    <Error Condition="!$([System.IO.File]::Exists('$(GflatBuildTasksPath)'))" Text="The precompiled gflat build task is missing: $(GflatBuildTasksPath). Keep build/tasks with the toolchain; for a source checkout, build the compiler first." />
    <GflatReadProjectInputs ProjectFile="$(MSBuildProjectFullPath)" Configuration="$(Configuration)" Platform="$(Platform)" NativeLinkOverrides="$(GflatNativeLinkOverrides)" PreprocessorOverrides="$(GflatPreprocessorOverrides)">
      <Output TaskParameter="IncludeDirectories" ItemName="_GflatIncludeDirectories" />
      <Output TaskParameter="Defines" ItemName="_GflatDefines" />
      <Output TaskParameter="ProjectInputs" ItemName="_GflatEvaluatedProjectInputs" />
      <Output TaskParameter="NativeLibraries" ItemName="_GflatNativeLibraries" />
      <Output TaskParameter="NativeLibraryDirectories" ItemName="_GflatNativeLibraryDirectories" />
      <Output TaskParameter="NativeLibraryFiles" ItemName="_GflatNativeLibraryFiles" />
      <Output TaskParameter="HasLogicalLibraries" PropertyName="_GflatHasLogicalLibraries" />
    </GflatReadProjectInputs>
    <ReadLinesFromFile File="$(_GflatIncludeDependencies)" Condition="Exists('$(_GflatIncludeDependencies)')">
      <Output TaskParameter="Lines" ItemName="_GflatPreviousIncludePaths" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_GflatProtectedFiles Include="@(_GflatPreviousIncludePaths)" />
      <_GflatProtectedFiles Include="$([MSBuild]::Escape('$(GflatPreprocessorOverrides)'))" Condition="'$(GflatPreprocessorOverrides)' != ''" />
      <_GflatProtectedFiles Include="@(_GflatSources);@(_GflatEvaluatedProjectInputs);@(_GflatNativeLibraryFiles)" />
      <_GflatProtectedFiles Include="$([MSBuild]::Escape('$(GflatNativeLinkOverrides)'))" Condition="'$(GflatNativeLinkOverrides)' != ''" />
    </ItemGroup>
    <PropertyGroup Condition="'$(OutputType)' == 'Executable'">
      <_GflatFullTargetPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(TargetPath)'))</_GflatFullTargetPath>
      <_GflatFullIRPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(GflatIROutput)'))</_GflatFullIRPath>
      <_GflatFullPdbPath Condition="'$(OS)' == 'Windows_NT'">$([System.IO.Path]::ChangeExtension('$(_GflatFullTargetPath)', '.pdb'))</_GflatFullPdbPath>
    </PropertyGroup>
    <Error Condition="'$(OutputType)' == 'Executable' and ('%(_GflatProtectedFiles.FullPath)' == '$(_GflatFullTargetPath)' or '%(_GflatProtectedFiles.FullPath)' == '$(_GflatFullIRPath)')" Text="Output must differ from source, project, and imported build files: %(_GflatProtectedFiles.FullPath)" />
    <Error Condition="'$(OutputType)' == 'Executable' and '$(_GflatFullPdbPath)' != '' and '%(_GflatProtectedFiles.FullPath)' == '$(_GflatFullPdbPath)'" Text="PDB output must differ from source, project, and imported build files: %(_GflatProtectedFiles.FullPath)" />
    <Error Condition="'%(_GflatProtectedFiles.FullPath)' == '$(_GflatSourceList)' or '%(_GflatProtectedFiles.FullPath)' == '$(_GflatBuildSettings)' or '%(_GflatProtectedFiles.FullPath)' == '$(_GflatBuildSuccess)'" Text="Generated build files must differ from source, project, and imported build files: %(_GflatProtectedFiles.FullPath)" />
    <Error Condition="'%(_GflatProtectedFiles.FullPath)' == '$(_GflatUpToDateState)'" Text="Up-to-date state must differ from source, project, and imported build files: %(_GflatProtectedFiles.FullPath)" />
    <Error Condition="'$(_GflatUpToDateState)' == '$(_GflatFullTargetPath)' or '$(_GflatUpToDateState)' == '$(_GflatFullIRPath)' or '$(_GflatUpToDateState)' == '$(_GflatFullPdbPath)' or '$(_GflatUpToDateState)' == '$(_GflatSourceList)' or '$(_GflatUpToDateState)' == '$(_GflatBuildSettings)' or '$(_GflatUpToDateState)' == '$(_GflatBuildSuccess)' or '$(_GflatUpToDateState)' == '$(_GflatNativeLinkManifest)' or '$(_GflatUpToDateState)' == '$(_GflatPreprocessorManifest)' or '$(_GflatUpToDateState)' == '$(_GflatIncludeDependencies)' or '$(_GflatUpToDateState)' == '$(_GflatIncludeDependencies).state'" Text="Up-to-date state must differ from other build outputs." />
    <Error Condition="'%(_GflatProtectedFiles.FullPath)' == '$(_GflatNativeLinkManifest)'" Text="Native link manifest must differ from every input file: %(_GflatProtectedFiles.FullPath)" />
    <Error Condition="'$(OutputType)' == 'Executable' and ('$(_GflatFullTargetPath)' == '$(_GflatSourceList)' or '$(_GflatFullTargetPath)' == '$(_GflatBuildSettings)' or '$(_GflatFullTargetPath)' == '$(_GflatBuildSuccess)' or '$(_GflatFullIRPath)' == '$(_GflatSourceList)' or '$(_GflatFullIRPath)' == '$(_GflatBuildSettings)' or '$(_GflatFullIRPath)' == '$(_GflatBuildSuccess)')" Text="Output must differ from the generated source list and incremental build stamps." />
    <Error Condition="'$(OutputType)' == 'Executable' and ('$(_GflatFullTargetPath)' == '$(_GflatNativeLinkManifest)' or '$(_GflatFullIRPath)' == '$(_GflatNativeLinkManifest)' or '$(_GflatFullPdbPath)' == '$(_GflatNativeLinkManifest)')" Text="Output must differ from the generated native link manifest." />
    <Error Condition="'$(_GflatNativeLinkManifest)' == '$(_GflatSourceList)' or '$(_GflatNativeLinkManifest)' == '$(_GflatBuildSettings)' or '$(_GflatNativeLinkManifest)' == '$(_GflatBuildSuccess)'" Text="Native link manifest must differ from other generated build files." />
    <Error Condition="'%(_GflatProtectedFiles.FullPath)' == '$(_GflatPreprocessorManifest)' or '%(_GflatProtectedFiles.FullPath)' == '$(_GflatIncludeDependencies)' or '%(_GflatProtectedFiles.FullPath)' == '$(_GflatIncludeDependencies).state'" Text="Preprocessor build files must differ from every input file." />
    <Error Condition="'$(_GflatFullPdbPath)' == '$(_GflatPreprocessorManifest)' or '$(_GflatFullPdbPath)' == '$(_GflatIncludeDependencies)' or '$(_GflatFullPdbPath)' == '$(_GflatIncludeDependencies).state' or '$(_GflatFullTargetPath)' == '$(_GflatPreprocessorManifest)' or '$(_GflatFullIRPath)' == '$(_GflatPreprocessorManifest)' or '$(_GflatFullTargetPath)' == '$(_GflatIncludeDependencies)' or '$(_GflatFullIRPath)' == '$(_GflatIncludeDependencies)' or '$(_GflatFullTargetPath)' == '$(_GflatIncludeDependencies).state' or '$(_GflatFullIRPath)' == '$(_GflatIncludeDependencies).state'" Text="Output must differ from preprocessor build files." />
  </Target>
  <Target Name="_GflatPrepare" DependsOnTargets="_GflatValidateOutputs">
    <Error Condition="'$(OutputType)' == 'Executable' and '@(_GflatSources)' == ''" Text="Executable project has no Compile items." />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <MakeDir Condition="'$(OutputType)' == 'Executable'" Directories="$([System.IO.Path]::GetDirectoryName('$(TargetPath)'))" />
    <MakeDir Condition="'$(GflatEmitIR)' == 'true'" Directories="$([System.IO.Path]::GetDirectoryName('$(_GflatFullIRPath)'))" />
    <!-- Keep the task's default UTF-8 encoding: explicit UTF-8 adds a BOM and
         prevents WriteOnlyWhenDifferent from preserving unchanged timestamps. -->
    <WriteLinesToFile File="$(_GflatSourceList)" Lines="@(_GflatSources)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <GflatWritePreprocessorInputs ManifestPath="$(_GflatPreprocessorManifest)" Directories="@(_GflatIncludeDirectories)" Defines="@(_GflatDefines)" />
    <GflatWriteNativeLinkInputs ManifestPath="$(_GflatNativeLinkManifest)" Libraries="@(_GflatNativeLibraries)" Directories="@(_GflatNativeLibraryDirectories)" />
  </Target>
  <Target Name="_GflatPrepareBuild" DependsOnTargets="_GflatPrepare">
    <GflatReadIncludeDependencies FilePath="$(_GflatIncludeDependencies)">
      <Output TaskParameter="Files" ItemName="_GflatIncludeFiles" />
    </GflatReadIncludeDependencies>
    <PropertyGroup>
      <_GflatOptions Condition="'$(OutputType)' == 'SourceLibrary'">--check</_GflatOptions>
      <_GflatOptions Condition="'$(OutputType)' == 'Executable'">-o &quot;$(TargetPath)&quot;</_GflatOptions>
      <_GflatOptions Condition="'$(GflatEmitIR)' == 'true' and '$(OutputType)' == 'Executable'">--emit-ir -o &quot;$(GflatIROutput)&quot;</_GflatOptions>
      <_GflatBuildOutput Condition="'$(OutputType)' == 'Executable'">$(TargetPath)</_GflatBuildOutput>
      <_GflatBuildOutput Condition="'$(OutputType)' == 'Executable' and '$(GflatEmitIR)' == 'true'">$(GflatIROutput)</_GflatBuildOutput>
      <_GflatDriverInput>$(GflatClang)</_GflatDriverInput>
      <_GflatDriverInput Condition="'$(_GflatDriverInput)' == ''">$(GflatDefaultClangInput)</_GflatDriverInput>
      <!-- Keep automatic caching limited to CLI-preflighted builds with known tools.
           Actual imports come from the task's items: MSBuildAllProjects also loses
           filename boundaries when an import path contains a semicolon. -->
      <_GflatCanCache Condition="'$(OutputType)' == 'Executable' and '$(GflatProjectInputs)' != '' and ('$(GflatEmitIR)' == 'true' or Exists('$(_GflatDriverInput)')) and (('$(GflatCompilerPath)' != '' and '$(GflatCompilerCommand)' == '$(_GflatKnownCompilerCommand)') or '@(GflatCompilerInputs)' != '')">true</_GflatCanCache>
      <!-- Names are resolved by the selected linker, so no exact file timestamp is known. -->
      <_GflatCanCache Condition="'$(GflatEmitIR)' != 'true' and '$(_GflatHasLogicalLibraries)' == 'true'">false</_GflatCanCache>
    </PropertyGroup>
    <ItemGroup>
      <_GflatCompilerFiles Include="$(GflatCompilerPath)" Condition="'$(GflatCompilerPath)' != ''" />
      <_GflatNativeOutputs Include="$(_GflatBuildOutput)" />
      <_GflatNativeOutputs Include="$(_GflatFullPdbPath)" Condition="'$(DebugSymbols)' == 'true' and '$(GflatEmitIR)' != 'true' and '$(_GflatFullPdbPath)' != ''" />
      <_GflatCompilerFiles Include="$([System.IO.Path]::GetDirectoryName('$(GflatCompilerPath)'))/*.dll;$([System.IO.Path]::GetDirectoryName('$(GflatCompilerPath)'))/*.json;$([System.IO.Path]::GetDirectoryName('$(GflatCompilerPath)'))/Runtime/*.cpp;$([System.IO.Path]::GetDirectoryName('$(GflatCompilerPath)'))/Runtime/*.c;$([System.IO.Path]::GetDirectoryName('$(GflatCompilerPath)'))/Standard/**/*.gf" Condition="'$(GflatCompilerPath)' != ''" />
      <_GflatBuildInputs Include="@(_GflatSources);@(_GflatEvaluatedProjectInputs);$([MSBuild]::Escape('$(GflatBuildTasksPath)'));@(_GflatCompilerFiles);@(GflatCompilerInputs)" />
      <_GflatBuildInputs Include="@(_GflatNativeLibraryFiles)" Condition="'$(GflatEmitIR)' != 'true'" />
      <_GflatBuildInputs Include="$([MSBuild]::Escape('$(_GflatNativeLinkManifest)'))" />
      <_GflatBuildInputs Include="$([MSBuild]::Escape('$(_GflatPreprocessorManifest)'));$([MSBuild]::Escape('$(_GflatIncludeDependencies).state'))" />
      <_GflatBuildInputs Include="$(GflatClang)" Condition="'$(GflatClang)' != '' and Exists('$(GflatClang)')" />
      <_GflatBuildInputs Include="$(GFLAT_CLANG)" Condition="'$(GflatClang)' == '' and '$(GFLAT_CLANG)' != '' and Exists('$(GFLAT_CLANG)')" />
      <_GflatBuildInputs Include="$(_GflatDriverInput)" Condition="'$(GflatEmitIR)' != 'true' and Exists('$(_GflatDriverInput)')" />
      <_GflatSetting Include="Compiler"><Value>$(GflatCompilerCommand)</Value></_GflatSetting>
      <_GflatSetting Include="Options"><Value>$(_GflatOptions)</Value></_GflatSetting>
      <_GflatSetting Include="Clang"><Value>$(GflatClang)</Value></_GflatSetting>
      <_GflatSetting Include="EnvironmentClang"><Value>$(GFLAT_CLANG)</Value></_GflatSetting>
      <_GflatSetting Include="Path"><Value>$(PATH)</Value></_GflatSetting>
      <_GflatSetting Include="LibraryPath"><Value>$(LIB)</Value></_GflatSetting>
      <_GflatSetting Include="NoStdLib"><Value>$(NoStdLib)</Value></_GflatSetting>
      <_GflatSetting Include="NoBuiltins"><Value>$(NoBuiltins)</Value></_GflatSetting>
      <_GflatSetting Include="Reserve"><Value>$(GflatExceptionReserveBytes)</Value></_GflatSetting>
      <_GflatSetting Include="Optimization"><Value>$(GflatOptimizationLevel)</Value></_GflatSetting>
      <_GflatSetting Include="DebugSymbols"><Value>$(DebugSymbols)</Value></_GflatSetting>
      <_GflatSetting Include="Mode"><Value>$(GflatEmitIR)</Value></_GflatSetting>
      <_GflatSetting Include="Output"><Value>$(_GflatBuildOutput)</Value></_GflatSetting>
      <_GflatSetting Include="Platform"><Value>$(Platform)</Value></_GflatSetting>
    </ItemGroup>
    <WriteLinesToFile File="$(_GflatBuildSettings)" Lines="@(_GflatSetting->'%(Identity)=%(Value)');@(_GflatBuildInputs)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Target Name="_GflatCheckOutputProvenance" Condition="'$(_GflatCanCache)' == 'true'">
    <!-- Another configuration or an external tool may have overwritten a shared
         output since this configuration last built successfully. -->
    <Delete Files="$(_GflatBuildSuccess)" Condition="Exists('$(_GflatBuildOutput)') and Exists('$(_GflatBuildSuccess)') and $([System.IO.File]::GetLastWriteTime('$(_GflatBuildOutput)').ToUniversalTime().Ticks) &gt; $([System.IO.File]::GetLastWriteTime('$(_GflatBuildSuccess)').ToUniversalTime().Ticks)" />
  </Target>
  <Target Name="_GflatCompile" DependsOnTargets="_GflatPrepareBuild;_GflatCheckOutputProvenance" Inputs="@(_GflatBuildInputs);@(_GflatIncludeFiles);$(_GflatSourceList);$(_GflatBuildSettings)" Outputs="@(_GflatNativeOutputs);$(_GflatBuildSuccess)" Condition="'$(_GflatCanCache)' == 'true'">
    <Delete Files="$(_GflatBuildSuccess)" />
    <Exec Condition="'@(_GflatSources)' != ''" Command="$(GflatCompilerCommand) --source-list &quot;$(_GflatSourceList)&quot; --native-link-inputs &quot;$(_GflatNativeLinkManifest)&quot; $(_GflatPreprocessorOption) $(_GflatStdLibOption) $(_GflatBuiltinsOption) $(_GflatOptions) $(_GflatDebugOption) $(_GflatClangOption) --exception-reserve-bytes &quot;$(GflatExceptionReserveBytes)&quot; --optimization &quot;$(GflatOptimizationLevel)&quot;" />
    <Touch Files="$(_GflatBuildSuccess)" AlwaysCreate="true" />
  </Target>
  <Target Name="_GflatBeginBuild" DependsOnTargets="_GflatValidateOutputs" Condition="'$(BuildingInsideVisualStudio)' == 'true'">
    <PropertyGroup><_GflatBuildStartedUtcTicks>$([System.DateTime]::UtcNow.Ticks)</_GflatBuildStartedUtcTicks></PropertyGroup>
    <Delete Files="$(_GflatUpToDateState)" />
  </Target>
  <Target Name="Build" DependsOnTargets="_GflatBeginBuild;_GflatPrepareBuild;_GflatCompile" Returns="$(_GflatBuildOutput)">
    <!-- Unknown commands and source-library checks stay uncached. -->
    <Delete Files="$(_GflatBuildSuccess)" Condition="'$(_GflatCanCache)' != 'true'" />
    <Exec Condition="'$(_GflatCanCache)' != 'true' and '@(_GflatSources)' != ''" Command="$(GflatCompilerCommand) --source-list &quot;$(_GflatSourceList)&quot; --native-link-inputs &quot;$(_GflatNativeLinkManifest)&quot; $(_GflatPreprocessorOption) $(_GflatStdLibOption) $(_GflatBuiltinsOption) $(_GflatOptions) $(_GflatDebugOption) $(_GflatClangOption) --exception-reserve-bytes &quot;$(GflatExceptionReserveBytes)&quot; --optimization &quot;$(GflatOptimizationLevel)&quot;" />
    <GflatWriteUpToDateState Condition="'$(BuildingInsideVisualStudio)' == 'true'" ProjectFile="$(MSBuildProjectFullPath)" FilePath="$(_GflatUpToDateState)" BuildStartedUtcTicks="$(_GflatBuildStartedUtcTicks)" />
  </Target>
  <Target Name="Check" DependsOnTargets="_GflatPrepare">
    <Exec Condition="'@(_GflatSources)' != ''" Command="$(GflatCompilerCommand) --source-list &quot;$(_GflatSourceList)&quot; --native-link-inputs &quot;$(_GflatNativeLinkManifest)&quot; $(_GflatPreprocessorOption) $(_GflatStdLibOption) $(_GflatBuiltinsOption) --check --exception-reserve-bytes &quot;$(GflatExceptionReserveBytes)&quot;" />
  </Target>
  <Target Name="Clean" DependsOnTargets="_GflatValidateOutputs">
    <PropertyGroup Condition="'$(OutputType)' == 'Executable'"><_GflatCleanExtension>$([System.IO.Path]::GetExtension('$(TargetPath)'))</_GflatCleanExtension></PropertyGroup>
    <Error Condition="'$(OutputType)' == 'Executable' and '$(_GflatCleanExtension)' != '.exe'" Text="Clean requires an .exe TargetPath; custom output names must be cleaned explicitly." />
    <Delete Files="$(_GflatFullTargetPath);$(_GflatFullIRPath);$(_GflatFullPdbPath)" Condition="'$(OutputType)' == 'Executable'" />
    <Delete Files="$(_GflatSourceList);$(_GflatBuildSettings);$(_GflatBuildSuccess);$(_GflatUpToDateState);$(_GflatNativeLinkManifest);$(_GflatPreprocessorManifest);$(_GflatIncludeDependencies);$(_GflatIncludeDependencies).state" />
  </Target>
  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />
  <Target Name="Restore" />
  <Target Name="GetTargetPath" Returns="$(TargetPath)" Condition="'$(OutputType)' == 'Executable'" />
  <PropertyGroup>
    <ImportDirectoryBuildTargets Condition="'$(ImportDirectoryBuildTargets)' == ''">true</ImportDirectoryBuildTargets>
    <DirectoryBuildTargetsPath Condition="'$(DirectoryBuildTargetsPath)' == '' and '$(ImportDirectoryBuildTargets)' == 'true'">$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildProjectDirectory)'))</DirectoryBuildTargetsPath>
  </PropertyGroup>
  <Import Project="$(DirectoryBuildTargetsPath)" Condition="'$(ImportDirectoryBuildTargets)' == 'true' and Exists('$(DirectoryBuildTargetsPath)')" />
</Project>
