<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishReadyToRun Condition="'$(PublishReadyToRun)' == '' and '$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="gflat.LanguageServer.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../gflat.Compiler/gflat.Compiler.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../gflat.Projects/gflat.Projects.csproj" />
  </ItemGroup>
</Project>
