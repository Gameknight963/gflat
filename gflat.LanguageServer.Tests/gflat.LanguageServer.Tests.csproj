    <Content Include="../editors/VisualStudio/gflat.tmLanguage.tmTheme" Link="EditorAssets/gflat.tmLanguage.tmTheme" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../editors/shared/*.json" Link="EditorAssets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Standard/core/Text/String.gf" Link="EditorFixtures/String.gf" CopyToOutputDirectory="PreserveNewest" />
